
option_settings:
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    runas: webapp

  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"

  03_seed_products:
    command: |
      source /var/app/venv/*/bin/activate
      PRODUCT_COUNT=$(python -c "import os; os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'greenbasket.settings'); import django; django.setup(); from products.models import Product; print(Product.objects.count())")
      if [ "$PRODUCT_COUNT" -eq 0 ]; then
        python manage.py add_sample_products
      else
        echo "Products already exist; skipping sample data"
      fi
    runas: webapp
